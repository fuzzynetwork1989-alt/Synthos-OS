# SynthOS Quest 3 Environment Configuration

# Application
NODE_ENV=development
APP_NAME=SynthOS XR
APP_VERSION=1.0.0

# AI Configuration
OLLAMA_ENDPOINT=http://localhost:11434
AI_MODEL=synthos-enhanced-20b
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Spatial SDK Configuration
META_SDK_USE_SIMULATION=true
META_SDK_PASSTHROUGH_QUALITY=high
META_SDK_HAND_TRACKING_ENABLED=true
META_SDK_EYE_TRACKING_ENABLED=true

# Audio Configuration
AUDIO_MASTER_VOLUME=1.0
AUDIO_SPATIAL_ENABLED=true
AUDIO_HRTF_ENABLED=true
AUDIO_SAMPLE_RATE=48000

# Voice Configuration
VOICE_ENABLED=true
VOICE_LANGUAGE=en-US
VOICE_CONTINUOUS_MODE=false
VOICE_WAKE_WORD=Hey SynthOS

# Performance Configuration
PERFORMANCE_TARGET_FPS=90
PERFORMANCE_RENDER_QUALITY=high
PERFORMANCE_POWER_SAVING=false
PERFORMANCE_ADAPTIVE_QUALITY=true

# Input Configuration
INPUT_MODE=mixed
INPUT_GESTURE_ENABLED=true
INPUT_GAZE_ENABLED=true
INPUT_CONTROLLER_ENABLED=true
INPUT_VOICE_ENABLED=true

# UI Configuration
UI_HOLOGRAPHIC_OPACITY=0.8
UI_PANEL_SIZE=medium
UI_ANIMATION_SPEED=normal

# Privacy Configuration
PRIVACY_DATA_COLLECTION=false
PRIVACY_ANALYTICS=false
PRIVACY_CRASH_REPORTS=true

# Developer Configuration
DEVELOPER_DEBUG_MODE=false
DEVELOPER_SHOW_FPS=false
DEVELOPER_SHOW_MEMORY=false
DEVELOPER_LOG_LEVEL=info