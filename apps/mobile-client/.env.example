# Synthos OS Mobile Client - Environment Configuration Template
# Copy this file to .env and fill in the actual values
# NEVER commit .env files with real credentials to version control

# ============================================
# EXPO CONFIGURATION
# ============================================
EXPO_TOKEN=your_expo_token_here
EXPO_PROJECT_ID=your_project_id_here

# ============================================
# API ENDPOINTS
# ============================================
# Backend API URL
API_BASE_URL=https://api.synthos-os.local
# WebSocket URL for real-time updates
WS_BASE_URL=wss://api.synthos-os.local/ws
# Model Gateway URL
MODEL_GATEWAY_URL=https://model-gateway.synthos-os.local

# ============================================
# IOS CODE SIGNING
# ============================================
# iOS Distribution Certificate Password
EXPO_IOS_DIST_P12_PASSWORD=your_ios_p12_password
# iOS Provisioning Profile Specifier
EXPO_IOS_PROVISIONING_PROFILE_SPECIFIER=your_profile_id
# Apple ID for App Store Connect
EXPO_APPLE_ID=your-apple-id@example.com
# App Store Connect App ID
EXPO_APPLE_ASC_APP_ID=YOUR_APP_STORE_CONNECT_APP_ID
# Apple Team ID
EXPO_APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID

# ============================================
# ANDROID CODE SIGNING
# ============================================
# Android Keystore Password
EXPO_ANDROID_KEYSTORE_PASSWORD=your_android_keystore_password
# Android Key Password
EXPO_ANDROID_KEY_PASSWORD=your_android_key_password
# Path to Google Play Service Account JSON (relative to project root)
EXPO_ANDROID_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# ============================================
# FEATURE FLAGS
# ============================================
# Enable local model processing
ENABLE_LOCAL_MODELS=true
# Enable cloud model fallback
ENABLE_CLOUD_MODELS=true
# Enable offline mode
ENABLE_OFFLINE_MODE=true
# Enable biometric authentication
ENABLE_BIOMETRIC_AUTH=true
# Enable location services
ENABLE_LOCATION_SERVICES=true
# Enable camera features
ENABLE_CAMERA=true
# Enable microphone features
ENABLE_MICROPHONE=true

# ============================================
# MODEL CONFIGURATION
# ============================================
# Default model provider (ollama, openai, anthropic, etc.)
DEFAULT_MODEL_PROVIDER=ollama
# Ollama endpoint for local models
OLLAMA_BASE_URL=http://localhost:11434
# Default model to use
DEFAULT_MODEL=llama2
# Maximum context length
MAX_CONTEXT_LENGTH=4096
# Temperature for model generation
DEFAULT_TEMPERATURE=0.7

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Enable analytics collection
ENABLE_ANALYTICS=true
# Analytics endpoint
ANALYTICS_ENDPOINT=https://analytics.synthos-os.local
# Error tracking endpoint
ERROR_TRACKING_ENDPOINT=https://errors.synthos-os.local
# Enable crash reporting
ENABLE_CRASH_REPORTING=true

# ============================================
# DEVELOPMENT OPTIONS
# ============================================
# Enable debug mode
DEBUG_MODE=false
# Enable dev tools
ENABLE_DEV_TOOLS=false
# Log level (error, warn, info, debug)
LOG_LEVEL=info
# Enable network logging
ENABLE_NETWORK_LOGGING=false

# ============================================
# SECURITY
# ============================================
# Encryption key for local storage (generate with: openssl rand -base64 32)
STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_here
# Enable secure storage only
SECURE_STORAGE_ONLY=true
# Session timeout in milliseconds
SESSION_TIMEOUT=3600000

# ============================================
# STORAGE & CACHE
# ============================================
# Maximum cache size in bytes
MAX_CACHE_SIZE=104857600
# Cache expiration time in milliseconds
CACHE_EXPIRATION=86400000
# Enable persistent storage
ENABLE_PERSISTENT_STORAGE=true

# ============================================
# NETWORK
# ============================================
# Request timeout in milliseconds
REQUEST_TIMEOUT=30000
# Maximum retry attempts
MAX_RETRY_ATTEMPTS=3
# Enable connection pooling
ENABLE_CONNECTION_POOLING=true

# ============================================
# UI/UX
# ============================================
# Theme (light, dark, automatic)
THEME=automatic
# Enable animations
ENABLE_ANIMATIONS=true
# Animation duration multiplier
ANIMATION_DURATION_MULTIPLIER=1.0
# Enable haptic feedback
ENABLE_HAPTIC_FEEDBACK=true