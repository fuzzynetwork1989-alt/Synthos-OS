{
  "name": "synthos-os",
  "version": "0.1.0",
  "description": "Next-Generation Cognitive, Agentic, and Self-Organizing AI Operating System",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:console\"",
    "dev:api": "cd services/api-gateway && npm run dev",
    "dev:console": "cd apps/operator-console && npm run dev",
    "build": "npm run build:apps && npm run build:packages",
    "build:apps": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
